{% comment %}
  Usage: {% render 'product-card', product: product %}
{% endcomment %}

{%- assign p = product -%}
<div class="product-card" data-category="{{ p.type | handleize }}">
  <div class="product-image-wrap">
    {%- if p.featured_image -%}
      <img src="{{ p.featured_image | image_url: width: 400 }}"
           alt="{{ p.featured_image.alt | escape }}"
           loading="lazy" width="400" height="300">
    {%- else -%}
      <span class="product-emoji">📦</span>
    {%- endif -%}

    {%- if p.tags contains 'new' -%}
      <span class="product-badge-tag tag-new">New</span>
    {%- elsif p.tags contains 'hot' -%}
      <span class="product-badge-tag tag-hot">🔥 Hot</span>
    {%- elsif p.compare_at_price > p.price -%}
      <span class="product-badge-tag tag-sale">Sale</span>
    {%- endif -%}

    <div class="product-actions">
      <button class="action-btn wishlist" aria-label="Add {{ p.title | escape }} to wishlist">🤍</button>
      <a href="{{ p.url }}?view=quick" class="action-btn" aria-label="Quick view {{ p.title | escape }}">👁</a>
    </div>
  </div>

  <div class="product-info">
    <div class="product-category">{{ p.type | default: 'Smart Product' }}</div>
    <h3 class="product-name">
      <a href="{{ p.url }}">{{ p.title }}</a>
    </h3>
    <p class="product-desc">{{ p.description | strip_html | truncate: 90 }}</p>

    <div class="product-rating">
      <span class="stars" aria-label="5 stars">★★★★★</span>
      <span class="rating-count">({{ p.metafields.reviews.count | default: '0' }})</span>
    </div>

    <div class="product-footer">
      <div class="product-price">
        <div class="price-current">{{ p.price | money }}</div>
        {%- if p.compare_at_price > p.price -%}
          <div class="price-original">{{ p.compare_at_price | money }}</div>
        {%- endif -%}
      </div>

      {%- if p.available -%}
        <button class="add-to-cart"
                data-product-id="{{ p.variants.first.id }}"
                aria-label="Add {{ p.title | escape }} to cart">
          🛒 Add
        </button>
      {%- else -%}
        <span class="btn" style="opacity:.5;cursor:not-allowed;">Sold Out</span>
      {%- endif -%}
    </div>
  </div>
</div>
