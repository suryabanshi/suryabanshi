<!-- ══ FEATURES / HOW IT WORKS ════════════════════════════════════════ -->
<section class="features-section" id="features" aria-labelledby="features-heading">
  <div class="orb orb-1" aria-hidden="true"></div>

  <div class="container">
    <div class="section-header reveal">
      <div class="badge">⚙️ {{ section.settings.badge | default: 'How It Works' }}</div>
      <h2 id="features-heading">
        {{ section.settings.heading | default: 'Built for' }}
        <span class="gradient-text">{{ section.settings.heading_accent | default: 'Every Lifestyle' }}</span>
      </h2>
      <p>{{ section.settings.subheading | default: 'Our smart ecosystem adapts to how you work and live — bringing seamless automation, intelligent insights, and effortless control to your fingertips.' }}</p>
    </div>

    <div class="features-grid">

      <!-- Large card: AI Productivity -->
      <div class="feature-card large reveal">
        <div>
          <div class="feature-icon icon-cyan">🤖</div>
          <h3>AI-Powered Productivity</h3>
          <p>Our intelligent engine learns your habits and automatically prioritizes tasks, schedules reminders, and surfaces insights so you stay ahead — not just on time.</p>
          <br>
          <p style="font-size:.82rem;color:var(--text-muted);">Powers over 2M+ daily tasks across 190+ countries.</p>
        </div>
        <div class="feature-visual">
          <div class="activity-title" style="color:var(--text-muted);font-size:.72rem;text-transform:uppercase;letter-spacing:.06em;margin-bottom:.75rem;">Productivity Score</div>
          <div class="progress-item">
            <div class="progress-label"><span>Focus Time</span><span>92%</span></div>
            <div class="progress-bar"><div class="progress-fill fill-cyan" data-width="92%"></div></div>
          </div>
          <div class="progress-item">
            <div class="progress-label"><span>Task Completion</span><span>88%</span></div>
            <div class="progress-bar"><div class="progress-fill fill-purple" data-width="88%"></div></div>
          </div>
          <div class="progress-item">
            <div class="progress-label"><span>Goal Achievement</span><span>94%</span></div>
            <div class="progress-bar"><div class="progress-fill fill-gold" data-width="94%"></div></div>
          </div>
          <div class="progress-item">
            <div class="progress-label"><span>Team Sync</span><span>79%</span></div>
            <div class="progress-bar"><div class="progress-fill fill-green" data-width="79%"></div></div>
          </div>
        </div>
        <div class="feature-number">01</div>
      </div>

      <!-- Card: Smart Home -->
      <div class="feature-card reveal">
        <div class="feature-icon icon-purple">🏠</div>
        <h3>Smart Home Automation</h3>
        <p>Control every device, routine, and scene from one unified hub. Schedules, voice commands, and geo-triggers make your home work for you.</p>
        <div class="feature-number">02</div>
      </div>

      <!-- Card: Global Delivery -->
      <div class="feature-card reveal">
        <div class="feature-icon icon-gold">🌍</div>
        <h3>Worldwide Express Delivery</h3>
        <p>Same-day dispatch to 190+ countries with real-time tracking, climate-safe packaging, and guaranteed delivery windows.</p>
        <div class="feature-number">03</div>
      </div>

      <!-- Card: 24/7 Support -->
      <div class="feature-card reveal">
        <div class="feature-icon icon-green">🎧</div>
        <h3>24/7 Expert Support</h3>
        <p>Human specialists ready around the clock via chat, call, or video — solving issues in minutes, not days, across all time zones.</p>
        <div class="feature-number">04</div>
      </div>

      <!-- Card: Secure Payments -->
      <div class="feature-card reveal">
        <div class="feature-icon icon-pink">🔐</div>
        <h3>Fortress-Grade Security</h3>
        <p>End-to-end encryption, multi-factor authentication, and fraud detection on every transaction — your data and money stay safe.</p>
        <div class="feature-number">05</div>
      </div>

      <!-- Card: Analytics -->
      <div class="feature-card reveal">
        <div class="feature-icon icon-blue">📊</div>
        <h3>Real-Time Analytics</h3>
        <p>Powerful dashboards reveal usage patterns, savings, and performance metrics — giving you the clarity to make smarter decisions every day.</p>
        <div class="feature-number">06</div>
      </div>

    </div>
  </div>
</section>

{% schema %}
{
  "name": "Features",
  "settings": [
    { "type": "text",     "id": "badge",           "label": "Badge Text",       "default": "How It Works" },
    { "type": "text",     "id": "heading",          "label": "Heading",          "default": "Built for" },
    { "type": "text",     "id": "heading_accent",   "label": "Heading Accent",   "default": "Every Lifestyle" },
    { "type": "textarea", "id": "subheading",       "label": "Subheading",       "default": "Our smart ecosystem adapts to how you work and live." }
  ],
  "presets": [{ "name": "Features" }]
}
{% endschema %}
