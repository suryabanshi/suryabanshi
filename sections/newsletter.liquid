<!-- ══ NEWSLETTER ══════════════════════════════════════════════════════ -->
<section class="newsletter-section" aria-labelledby="newsletter-heading">
  <div class="orb orb-1" aria-hidden="true"></div>

  <div class="container">
    <div class="newsletter-box reveal">
      <div class="badge" style="margin-bottom:1.5rem;justify-content:center;">
        📩 {{ section.settings.badge | default: 'Stay in the Loop' }}
      </div>
      <h2 id="newsletter-heading">
        {{ section.settings.heading | default: 'Smart Deals, Delivered' }}<br>
        <span class="gradient-text">{{ section.settings.heading_accent | default: 'to Your Inbox' }}</span>
      </h2>
      <p>{{ section.settings.subheading | default: 'Get exclusive early access to new products, members-only discounts, productivity tips from our experts, and monthly smart living guides — no spam, ever.' }}</p>

      {% form 'customer', id: 'newsletter-form', class: 'newsletter-form' %}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <input type="email"
               name="contact[email]"
               placeholder="{{ section.settings.placeholder | default: 'your@email.com' }}"
               required
               autocomplete="email"
               aria-label="Email address">
        <button type="submit" class="btn btn-primary">
          {{ section.settings.button_text | default: 'Subscribe Free' }}
        </button>
      {% endform %}

      <p class="newsletter-note">🔒 {{ section.settings.note | default: 'We respect your privacy. Unsubscribe at any time — no hard feelings.' }}</p>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Newsletter",
  "settings": [
    { "type": "text",     "id": "badge",        "label": "Badge",        "default": "Stay in the Loop" },
    { "type": "text",     "id": "heading",       "label": "Heading",      "default": "Smart Deals, Delivered" },
    { "type": "text",     "id": "heading_accent","label": "Accent",       "default": "to Your Inbox" },
    { "type": "textarea", "id": "subheading",    "label": "Subheading" },
    { "type": "text",     "id": "placeholder",   "label": "Placeholder",  "default": "your@email.com" },
    { "type": "text",     "id": "button_text",   "label": "Button Text",  "default": "Subscribe Free" },
    { "type": "text",     "id": "note",          "label": "Privacy Note" }
  ],
  "presets": [{ "name": "Newsletter" }]
}
{% endschema %}
