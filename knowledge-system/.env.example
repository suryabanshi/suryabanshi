# ============================================================
# Knowledge Extraction System — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# ── Supabase (required) ──────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=eyJ...   # Service role key (full access)
SUPABASE_ANON_KEY=eyJ...      # Anon key (for client-side use)

# ── Anthropic / Claude (required) ───────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-sonnet-4-6
CLAUDE_MAX_TOKENS=4096

# ── OpenAI (for embeddings — optional but recommended) ───────
OPENAI_API_KEY=sk-...
EMBEDDING_MODEL=text-embedding-3-small

# ── Google Drive (optional) ──────────────────────────────────
GOOGLE_CREDENTIALS_FILE=credentials/google_service_account.json
GOOGLE_DRIVE_FOLDER_ID=           # Leave empty for entire Drive

# ── Dropbox (optional) ───────────────────────────────────────
DROPBOX_ACCESS_TOKEN=

# ── Notion (optional) ────────────────────────────────────────
NOTION_API_KEY=secret_...
NOTION_DATABASE_IDS=db-id-1,db-id-2   # Comma-separated

# ── GitHub (optional) ────────────────────────────────────────
GITHUB_TOKEN=ghp_...
GITHUB_USERNAME=your-username

# ── Processing ───────────────────────────────────────────────
BATCH_SIZE=20
DEDUP_THRESHOLD=0.92

# ── Scheduling ───────────────────────────────────────────────
SYNC_INTERVAL_MINUTES=60
INSIGHT_REFRESH_HOURS=24

# ── API Server ───────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
API_SECRET_KEY=change-this-to-a-random-secret-in-production
CORS_ORIGINS=http://localhost:3000,https://your-dashboard.com

# ── Notifications (optional) ─────────────────────────────────
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
GOOGLE_SHEET_ID=                  # For sync log spreadsheet
